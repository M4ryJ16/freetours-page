---
import Nav from "@/components/Nav.astro";
import ReviewCard from "@/components/ReviewCard.astro";
import ReviewFormCard from "@/components/ReviewFormCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { ApiError, getTour, getAllTourReviews, getTourReviewSummary, getCurrentCustomer } from "@/lib/api.js";
import { getSessionToken, clearSessionCookie } from "@/lib/session.js";
import "@/styles/global.css";
import AutoTranslator from "@/components/AutoTranslator.astro";

export const prerender = false;

const { id } = Astro.params;

let tour: any = null;

try {
  tour = await getTour(id as string);
} catch (err) {
  if (err instanceof ApiError && err.status === 404) {
    return Astro.redirect('/404');
  }
  throw err;
}

if (!tour.is_active) {
  return Astro.redirect('/404');
}

if (Array.isArray(tour.gallery)) {
  tour.gallery = [...tour.gallery].sort((a: any, b: any) => a.position - b.position);
}

interface ApiReview {
  id: string;
  stars: number;
  content: string | null;
  tour_id: string;
  customer_id: string;
  created_at: string;
  tour_name: string;
  customer_name: string;
}

interface ReviewSummary {
  tourId: string;
  reviewCount: number;
  averageStars: number;
  breakdown: Record<string, number>;
}

interface CurrentCustomer {
  id: string;
  full_name: string;
  email: string;
}

let reviews: ApiReview[] = [];
let summary: ReviewSummary | null = null;
let reviewsError = false;

try {
  [reviews, summary] = await Promise.all([
    getAllTourReviews(tour.id),
    getTourReviewSummary(tour.id)
  ]);
} catch (err) {
  console.error('Failed to load reviews for this tour', err);
  reviewsError = true;
}

// Resolve the logged-in customer (if any) from the session cookie — same
// pattern as Booking.astro — so we know whether to show the review form,
// a "you've already reviewed this" note, or a login prompt.
let currentCustomer: CurrentCustomer | null = null;
const sessionToken = getSessionToken(Astro.cookies);
if (sessionToken) {
  try {
    currentCustomer = await getCurrentCustomer(sessionToken);
  } catch {
    clearSessionCookie(Astro.cookies);
  }
}

const myReview = currentCustomer
  ? reviews.find((r) => r.customer_id === currentCustomer!.id) ?? null
  : null;

function splitCaption(text: string): { title: string | null; body: string | null } {
  const trimmed = text.trim();
  
  // Changed {1,40} to + so it accommodates titles of any length before the first punctuation
  const match = trimmed.match(/^([^.!?]+[.!?][)\]"']?)\s+([\s\S]*)$/);
  
  if (match && match[2]) {
    const cleanTitle = match[1].replace(/[.!?]+([)\]"']*)$/, '$1');
    return { title: cleanTitle, body: match[2] };
  }
  
  return { title: null, body: trimmed };
}

// Each gallery image is one stop on the route: its alt text is split into
// a short title (the stop's name) and a body (what happens there), the
// same convention used to compose booking-ticket copy elsewhere. Numbered
// 1, 2, 3… in gallery order, mirroring the waypoint layout used in the
// "arrival guide" post.
const routeStops = (tour.gallery ?? [])
  .filter((img: any) => img.position !== 0)
  .map((img: any, index: number) => {
    const parts = img.alt ? splitCaption(img.alt) : null;
    return {
      number: index + 1,
      image: img,
      title: parts?.title ?? null,
      body: parts?.body ?? (parts ? null : img.alt ?? null)
    };
  });

// --- UPDATED: Helper that builds a "de X a Y" duration range ---
function formatTimeParts(hours: number, minutes: number) {
  const parts = [];
  if (hours > 0) parts.push(hours === 1 ? "1 hora" : `${hours} horas`);
  if (minutes > 0) parts.push(`${minutes} minutos`);
  return parts.join(" y ");
}

function formatDuration(hoursFloat: number | null) {
  if (!hoursFloat) return "Duración flexible";

  const startHours = Math.floor(hoursFloat);
  const startMinutes = Math.round((hoursFloat - startHours) * 60);

  let endHours: number;
  let endMinutes: number;

  if (startMinutes > 0) {
    // Has minutes → round up to the next whole hour
    endHours = startHours + 1;
    endMinutes = 0;
  } else {
    // Exact hour → add half an hour
    endHours = startHours;
    endMinutes = 30;
  }

  return `De ${formatTimeParts(startHours, startMinutes)} a ${formatTimeParts(endHours, endMinutes)} de trayecto`;
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{tour.name} — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="description" content={tour.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  </head>
  <body>
    <Nav />
    <main>
      <section class="tour-detail">
        <div class="wrap tour-detail__inner">
          <p class="eyebrow">Excursión gratuita</p>
          <h1 class="tour-detail__title">{tour.name}</h1>
          <p class="tour-detail__desc">{tour.description}</p>

          <div class="tour-detail__meta">
            {<span>{formatDuration(Number(tour.duration_hours))}</span>}
            {summary && summary.reviewCount > 0 && (
              <span>★ {summary.averageStars.toFixed(1)} ({summary.reviewCount} {summary.reviewCount === 1 ? 'reseña' : 'reseñas'})</span>
            )}
          </div>

          {tour.meeting_point_lat != null && tour.meeting_point_lng != null && (
            <section class="tour-detail__map-section">
              <h2 class="tour-detail__map-title">Punto de encuentro</h2>
              {tour.meeting_point && <p class="tour-detail__map-address">{tour.meeting_point}</p>}
              <div id="meeting-point-map" class="tour-detail__map"></div>
              <p class="tour-detail__map-attribution">
                Mapa de <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors
              </p>
            </section>
          )}

          {routeStops.length > 0 && (
            <div class="tour-route-section">
              <h2 class="tour-route-section__title">¿Qué veremos durante el tour?</h2>
              <p class="tour-route-section__lede">El recorrido está dividido en puntos — así es, paso a paso.</p>

              <div class="tour-route">
                {routeStops.map((stop: any) => (
                  <div class="tour-route__stop">
                    <div class="tour-route__marker">{stop.number}</div>
                    <div class="tour-route__content">
                      <figure class="tour-route__figure">
                        <img src={stop.image.url} alt={stop.image.alt ?? tour.name} loading="lazy" />
                      </figure>
                      <div class="tour-route__text">
                        {stop.title && <h3 class="tour-route__stop-title">{stop.title}</h3>}
                        {stop.body && <p class="tour-route__stop-body">{stop.body}</p>}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <a href={`/reservar?tour=${tour.id}`} class="btn orange-btn rounded-btn">Reservar esta ruta</a>
        </div>
      </section>

        {tour.stops && tour.stops.length > 0 && (
          <section class="tour-stops-map-section">
            <div class="wrap">
              <h2 class="tour-stops-map-section__title">Mapa de la ruta</h2>
              <div id="tour-stops-map" class="tour-stops-map"></div>
              <p class="tour-detail__map-attribution">
                Mapa de <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors
              </p>
            </div>
          </section>
        )}

      <section class="tour-reviews" id="reviews">
        <div class="wrap">
          <p class="eyebrow">Reseñas</p>
          <h2 class="tour-reviews__title">Opiniones de esta ruta</h2>

          {reviewsError && (
            <p class="tour-reviews__notice">
              No hemos podido cargar las reseñas en este momento. Inténtalo de nuevo más tarde.
            </p>
          )}

          {!reviewsError && (
            <div class="review-form-wrap">
              {currentCustomer && myReview && (
                <div class="review-cta review-cta--done">
                  <p>Ya has dejado una reseña para esta ruta. ¡Gracias por compartir tu opinión!</p>
                </div>
              )}

              {currentCustomer && !myReview && (
                <ReviewFormCard tourId={tour.id} gridSelector="reviews-grid" gridClass="tour-reviews__grid" />
              )}
            </div>
          )}

          {!reviewsError && reviews.length === 0 && (
            <p class="tour-reviews__notice" id="reviews-empty-notice">Todavía no hay reseñas para esta ruta.</p>
          )}

          {!reviewsError && reviews.length > 0 && (
            <div class="tour-reviews__grid" id="reviews-grid">
              {reviews.map((r) => (
                <ReviewCard content={r.content} stars={r.stars} customerName={r.customer_name} />
              ))}
            </div>
          )}
        </div>
      </section>
    </main>

    <SiteFooter />
    <AutoTranslator />
  </body>
</html>

<style is:global>
  .tour-stops-map-section {
    background: var(--parchment);
    padding-block: 0 70px;
  }
  .tour-stops-map-section__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    color: var(--ink);
    margin: 10px 0 20px;
  }
  .tour-stops-map {
    width: 100%;
    height: 380px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(24, 34, 25, 0.12);
  }
  .tour-stops-map__marker span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--forest-deep);
    color: var(--gold);
    border: 2px solid var(--gold);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
  }
  .tour-stops-map .leaflet-popup-content {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .tour-stops-map { height: 280px; }
  }
  .tour-detail {
    background: var(--parchment);
    padding-block: 64px 60px;
  }
  .tour-detail__inner { max-width: 760px; }
  .tour-detail__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    color: var(--ink);
    margin: 10px 0 18px;
  }
  .tour-detail__desc {
    font-size: 1rem;
    line-height: 1.7;
    color: #3c4a3d;
    margin: 0 0 22px;
  }
  .tour-detail__meta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 0.85rem;
    font-weight: bold;
    color: var(--gold);
    margin: 0 0 28px;
  }

  .tour-detail__map-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .tour-detail__map-address {
    font-size: 0.9rem;
    color: #5a6b5c;
    margin: 0 0 14px;
  }
  .tour-detail__map {
    width: 100%;
    height: 320px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(24, 34, 25, 0.12);
  }
  .tour-detail__map-attribution {
    font-size: 0.72rem;
    color: #9a9284;
    margin: 8px 0 0;
  }
  .tour-detail__map-attribution a { color: inherit; text-decoration: underline; }

  .tour-detail__map-section {
    background: var(--parchment);
    margin-block: 8px 40px;
  }

  .tour-detail__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 14px;
    margin-top: 40px;
  }

  /* ---------- Route / waypoints (numbered stops, like the arrival-guide post) ---------- */
  .tour-route-section {
    margin-top: 56px;
    margin-bottom: 45px;
  }
  .tour-route-section__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    color: var(--ink);
    margin: 0 0 10px;
  }
  .tour-route-section__lede {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #3c4a3d;
    margin: 0 0 28px;
  }

  .tour-route {
    position: relative;
    padding-left: 56px;
  }
  /* the dashed connecting line running through every marker, same device
     used on the arrival-guide page's waypoint list */
  .tour-route::before {
    content: "";
    position: absolute;
    left: 19px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background-image: linear-gradient(to bottom, var(--gold) 60%, transparent 0%);
    background-size: 2px 12px;
    background-repeat: repeat-y;
  }

  .tour-route__stop {
    position: relative;
    padding-block: 32px;
    border-bottom: 1px solid rgba(24, 34, 25, 0.12);
  }
  .tour-route__stop:first-child { padding-top: 4px; }
  .tour-route__stop:last-child { border-bottom: none; }

  .tour-route__marker {
    position: absolute;
    left: -56px;
    top: 32px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--forest-deep);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    border: 2px solid var(--gold);
  }

  .tour-route__content {
    display: grid;
    grid-template-columns: minmax(200px, 280px) 1fr;
    gap: 24px;
    align-items: center;
  }
  .tour-route__figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(24, 34, 25, 0.1);
  }
  .tour-route__figure img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    display: block;
  }
  .tour-route__stop-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .tour-route__stop-body {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #3c4a3d;
    margin: 0;
  }

  @media (max-width: 620px) {
    .tour-route { padding-left: 44px; }
    .tour-route::before { left: 15px; }
    .tour-route__marker { left: -44px; width: 32px; height: 32px; font-size: 0.9rem; top: 28px; }
    .tour-route__content { grid-template-columns: 1fr; }
    .tour-route__figure img { height: 200px; }
  }

  .tour-reviews {
    background: var(--parchment);
    padding-block: 20px 100px;
  }
  .tour-reviews__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    margin: 10px 0 30px;
    color: var(--ink);
  }
  .tour-reviews__notice {
    font-size: 0.95rem;
    color: #5a6b5c;
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.12);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin: 0 0 22px;
  }
  .tour-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  /* ---------- Review form / CTA ---------- */
  .review-form-wrap { margin-bottom: 30px; }

  .review-cta {
    background: var(--cream);
    border: 1px dashed rgba(24, 34, 25, 0.18);
    border-radius: var(--radius);
    padding: 16px 20px;
    font-size: 0.92rem;
    color: #4a5b4c;
  }
  .review-cta a { color: var(--russet); text-decoration: underline; }
  .review-cta--done {
    background: rgba(72, 122, 74, 0.1);
    border-color: rgba(72, 122, 74, 0.3);
    color: #2e5c30;
  }


  @media (max-width: 940px) {
    .tour-reviews__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .tour-reviews__grid { grid-template-columns: 1fr; }
    .tour-detail__map { height: 240px; }
  }

</style>

<script define:vars={{ stops: tour.stops ?? [], meetingLat: tour.meeting_point_lat, meetingLng: tour.meeting_point_lng, meetingAddress: tour.meeting_point ?? '' }}>
  function initStopsMap() {
    const mapEl = document.getElementById('tour-stops-map');
    if (!mapEl || typeof L === 'undefined') return;

    const points = [];
    if (meetingLat != null && meetingLng != null) {
      points.push({ lat: meetingLat, lng: meetingLng, label: meetingAddress || 'Punto de encuentro', isStart: true });
    }
    stops.forEach((s, i) => {
      points.push({ lat: s.lat, lng: s.lng, label: s.name, description: s.description, number: i + 1 });
    });
    if (points.length === 0) return;

    const map = L.map('tour-stops-map', { scrollWheelZoom: false });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    function numberedIcon(label) {
      return L.divIcon({
        className: 'tour-stops-map__marker',
        html: `<span>${label}</span>`,
        iconSize: [32, 32],
        iconAnchor: [16, 16]
      });
    }

    const latlngs = [];
    points.forEach((p) => {
      const marker = L.marker([p.lat, p.lng], { icon: numberedIcon(p.isStart ? 'P' : p.number) }).addTo(map);
      const parts = [`<strong>${p.isStart ? 'Punto de encuentro' : (p.label ?? `Parada ${p.number}`)}</strong>`];
      if (p.description) parts.push(p.description);
      marker.bindPopup(parts.join('<br>'));
      latlngs.push([p.lat, p.lng]);
    });

    if (latlngs.length > 1) {
      L.polyline(latlngs, { color: '#d99b32', weight: 3, dashArray: '6 8' }).addTo(map);
      map.fitBounds(latlngs, { padding: [30, 30] });
    } else {
      map.setView(latlngs[0], 16);
    }
  }

  if (typeof L !== 'undefined') {
    initStopsMap();
  } else {
    window.addEventListener('load', initStopsMap);
  }
</script>

<script define:vars={{ lat: tour.meeting_point_lat, lng: tour.meeting_point_lng, address: tour.meeting_point ?? '' }}>
  function initMeetingPointMap() {
    if (lat == null || lng == null) return;
    const mapEl = document.getElementById('meeting-point-map');
    if (!mapEl || typeof L === 'undefined') return;

    const map = L.map('meeting-point-map', { scrollWheelZoom: false }).setView([lat, lng], 16);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);
    L.marker([lat, lng]).addTo(map).bindPopup(address || 'Punto de encuentro');
  }

  if (typeof L !== 'undefined') {
    initMeetingPointMap();
  } else {
    window.addEventListener('load', initMeetingPointMap);
  }
</script>
