---
// @ts-nocheck
import { listAllTours } from "@/lib/adminApi.js";
import AdminLayout from "@/components/AdminLayout.astro";
import AdminPageHead from "@/components/AdminPageHead.astro";
import AdminNotice from "@/components/AdminNotice.astro";
import AdminBanner from "@/components/AdminBanner.astro";
import AdminTable from "@/components/AdminTable.astro";
import AdminLinkButton from "@/components/AdminLinkButton.astro";
import AdminModal from "@/components/AdminModal.astro";
import AdminField from "@/components/AdminField.astro";
import AdminMapPicker from "@/components/AdminMapPicker.astro";
import AdminCoordFields from "@/components/AdminCoordFields.astro";
import AdminCheckbox from "@/components/AdminCheckbox.astro";

export const prerender = false;

interface ApiTour {
  id: string;
  name: string;
  description: string;
  duration_hours: number | null;
  capacity: number | null;
  is_active: boolean;
}

let tours: ApiTour[] = [];
let loadError: string | null = null;

function formatDuration(hours: number | null): string {
  if (!hours) return "—";
  const totalMinutes = Math.round(hours * 60);
  const h = Math.floor(totalMinutes / 60);
  const m = totalMinutes % 60;
  if (h === 0) return `${m} min`;
  if (m === 0) return `${h} ${h === 1 ? "hora" : "horas"}`;
  return `${h} ${h === 1 ? "hora" : "horas"} con ${m} min`;
}

try {
  tours = await listAllTours();
} catch (err) {
  console.error("No se han podido cargar las excursiones para el panel de admin", err);
  loadError = "No se han podido cargar las excursiones. Recarga la página.";
}
---

<AdminLayout title="Panel de excursiones" tag="Panel de excursiones" leaflet confirm>
  <AdminPageHead eyebrow="Catálogo" title="Excursiones">
    <button slot="actions" type="button" class="btn orange-btn rounded-btn" id="new-tour-btn">+ Nueva excursión</button>
  </AdminPageHead>

  {loadError && <AdminNotice error>{loadError}</AdminNotice>}

  <AdminBanner />

  <AdminTable
    id="tours-table"
    tbodyId="tours-tbody"
    columns={[
      { label: "Nombre" },
      { label: "Duración" },
      { label: "Aforo" },
      { label: "Estado" },
      { label: "Acciones", class: "admin__col-actions" },
    ]}
    empty={tours.length === 0 && !loadError ? "Todavía no hay excursiones. Crea la primera con el botón de arriba." : undefined}
  >
    {tours.map((t) => (
      <tr data-tour-row={t.id}>
        <td class="admin__cell-name">
          <span class="admin__tour-name">{t.name}</span>
        </td>
        <td>{formatDuration(t.duration_hours)}</td>
        <td>{t.capacity ?? "—"}</td>
        <td>
          <span class={`admin__status admin__status--${t.is_active ? "active" : "archived"}`}>
            {t.is_active ? "Activa" : "Archivada"}
          </span>
        </td>
        <td class="admin__col-actions">
          <AdminLinkButton data-edit-tour={t.id}>Editar</AdminLinkButton>
          <AdminLinkButton href={`/admin/schedules?tour=${t.id}`}>Horarios</AdminLinkButton>
          <AdminLinkButton href={`/admin/dates?tour=${t.id}`}>Fechas</AdminLinkButton>
          <AdminLinkButton href={`/admin/images?tour=${t.id}`}>Imagenes</AdminLinkButton>
          <AdminLinkButton href={`/admin/stops?tour=${t.id}`}>Puntos</AdminLinkButton>
          <AdminLinkButton danger data-toggle-tour={t.id} data-active={String(t.is_active)}>
            {t.is_active ? "Archivar" : "Reactivar"}
          </AdminLinkButton>
        </td>
      </tr>
    ))}
  </AdminTable>

  <!-- Create / edit panel -->
  <AdminModal
    slot="after"
    overlayId="tour-overlay"
    formId="tour-form"
    idFieldId="tour-id"
    title="Nueva excursión"
    submitLabel="Guardar excursión"
  >
    <AdminField label="Nombre" for="f-name" required>
      <input type="text" id="f-name" maxlength="255" required />
    </AdminField>

    <AdminField label="Descripción" for="f-description" required>
      <textarea id="f-description" rows="4" required></textarea>
    </AdminField>

    <AdminMapPicker
      label="Punto de encuentro (OpenStreetMap)"
      searchId="f-meeting-search"
      mapId="f-meeting-map"
      hint="Busca una dirección o haz clic en el mapa para fijar el punto de encuentro exacto."
    />

    <AdminField label="Dirección" for="f-meeting-address" required>
      <input type="text" id="f-meeting-address" maxlength="500" required />
    </AdminField>

    <AdminCoordFields latId="f-meeting-lat" lngId="f-meeting-lng" />

    <div class="field-row">
      <AdminField label="Duración — horas" for="f-duration-hours">
        <input type="number" id="f-duration-hours" min="0" step="1" placeholder="p. ej. 2" />
      </AdminField>
      <AdminField label="Duración — minutos" for="f-duration-minutes">
        <input type="number" id="f-duration-minutes" min="0" max="59" step="1" placeholder="p. ej. 30" />
      </AdminField>
    </div>

    <AdminField label="Aforo máximo" for="f-capacity">
      <input type="number" id="f-capacity" min="1" step="1" />
    </AdminField>

    <AdminField label="Imagen destacada" for="f-image" optional hintId="f-image-hint">
      <div class="cover-preview is-hidden" id="cover-preview">
        <img id="cover-preview-img" alt="Imagen destacada actual" />
        <span>Imagen actual</span>
      </div>
      <input type="file" id="f-image" accept="image/jpeg,image/png,image/webp,image/gif" />
    </AdminField>

    <AdminCheckbox id="f-active" label="Excursión activa (visible en la web)" checked />
  </AdminModal>
</AdminLayout>

<style is:global>
  .admin__status {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 4px 11px;
  }

  .admin__status--active { background: rgba(72, 122, 74, 0.14); color: #2e5c30; }

  .admin__status--archived { background: rgba(24, 34, 25, 0.08); color: #6b6b5f; }

  .cover-preview {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 0.8rem;
    color: #7a7562;
  }

  .cover-preview.is-hidden { display: none; }

  .cover-preview img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid rgba(24, 34, 25, 0.15);
  }
</style>

<script>
      import { initConfirmDialog, confirmDialog } from "@/lib/confirmDialog.js";

      initConfirmDialog();


      interface Tour {
        id: string;
        name: string;
        description: string;
        meeting_point: string | null;
        meeting_point_lat: number | null;
        meeting_point_lng: number | null;
        meeting_point_osm_id?: string | null;
        duration_hours: number | null;
        capacity: number | null;
        is_active: boolean;
        gallery?: { id: string; url: string; alt: string | null; position: number }[];
      }

      const DUBLIN_CENTER: [number, number] = [53.3498, -6.2603];

      const tbody = document.getElementById("tours-tbody") as HTMLTableSectionElement;
      const banner = document.getElementById("admin-banner") as HTMLParagraphElement;

      const overlay = document.getElementById("tour-overlay") as HTMLDivElement;
      const panelTitle = document.getElementById("panel-title") as HTMLHeadingElement;
      const form = document.getElementById("tour-form") as HTMLFormElement;
      const panelError = document.getElementById("panel-error") as HTMLParagraphElement;
      const panelSubmit = document.getElementById("panel-submit") as HTMLButtonElement;

      const idField = document.getElementById("tour-id") as HTMLInputElement;
      const nameField = document.getElementById("f-name") as HTMLInputElement;
      const descField = document.getElementById("f-description") as HTMLTextAreaElement;
      const addressField = document.getElementById("f-meeting-address") as HTMLInputElement;
      const latField = document.getElementById("f-meeting-lat") as HTMLInputElement;
      const lngField = document.getElementById("f-meeting-lng") as HTMLInputElement;
      const searchInput = document.getElementById("f-meeting-search") as HTMLInputElement;
      const searchBtn = document.getElementById("f-meeting-search-btn") as HTMLButtonElement;
      const durationHoursField = document.getElementById("f-duration-hours") as HTMLInputElement;
      const durationMinutesField = document.getElementById("f-duration-minutes") as HTMLInputElement;
      const capacityField = document.getElementById("f-capacity") as HTMLInputElement;
      const activeField = document.getElementById("f-active") as HTMLInputElement;
      const imageField = document.getElementById("f-image") as HTMLInputElement;
      const imageHint = document.getElementById("f-image-hint") as HTMLParagraphElement;
      const coverPreview = document.getElementById("cover-preview") as HTMLDivElement;
      const coverPreviewImg = document.getElementById("cover-preview-img") as HTMLImageElement;

      let knownTours = new Map<string, Tour>();

      function formatDuration(hours: number | null): string {
        if (!hours) return "—";
        const totalMinutes = Math.round(hours * 60);
        const h = Math.floor(totalMinutes / 60);
        const m = totalMinutes % 60;
        if (h === 0) return `${m} min`;
        if (m === 0) return `${h} ${h === 1 ? "hora" : "horas"}`;
        return `${h} ${h === 1 ? "hora" : "horas"} con ${m} min`;
      }

      // ---------- OpenStreetMap (Leaflet) meeting-point picker ----------
      let map: any = null;
      let marker: any = null;

      function ensureMap() {
        if (map) return;
        // @ts-ignore — Leaflet is loaded globally via the CDN <script> tag in <head>
        map = L.map("f-meeting-map").setView(DUBLIN_CENTER, 12);
        // @ts-ignore
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);
        map.on("click", (e: any) => setMarker(e.latlng.lat, e.latlng.lng));
      }

      function setMarker(lat: number, lng: number) {
        latField.value = lat.toFixed(6);
        lngField.value = lng.toFixed(6);
        if (marker) {
          marker.setLatLng([lat, lng]);
        } else {
          // @ts-ignore
          marker = L.marker([lat, lng]).addTo(map);
        }
        map.setView([lat, lng], Math.max(map.getZoom(), 15));
      }

      function clearMarker() {
        if (marker && map) {
          map.removeLayer(marker);
          marker = null;
        }
        latField.value = "";
        lngField.value = "";
        map?.setView(DUBLIN_CENTER, 12);
      }

      searchBtn?.addEventListener("click", async () => {
        const query = searchInput.value.trim();
        if (!query) return;

        searchBtn.disabled = true;
        const originalLabel = searchBtn.textContent;
        searchBtn.textContent = "Buscando…";

        try {
          const res = await fetch(
            `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(query)}`,
            { headers: { Accept: "application/json" } }
          );
          const results = await res.json();
          if (!Array.isArray(results) || results.length === 0) {
            panelError.textContent =
              "No se ha encontrado esa dirección. Prueba con otra búsqueda o marca el punto directamente en el mapa.";
            panelError.classList.remove("is-hidden");
            return;
          }
          panelError.classList.add("is-hidden");
          const { lat, lon, display_name } = results[0];
          setMarker(Number(lat), Number(lon));
          addressField.value = display_name;
        } catch {
          panelError.textContent = "No se ha podido buscar la dirección. Inténtalo de nuevo.";
          panelError.classList.remove("is-hidden");
        } finally {
          searchBtn.disabled = false;
          searchBtn.textContent = originalLabel;
        }
      });

      function showBanner(message: string, isError = false) {
        banner.textContent = message;
        banner.classList.remove("is-hidden");
        banner.classList.toggle("admin__banner--error", isError);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      function rowHtml(t: Tour) {
        return `
          <td class="admin__cell-name"><span class="admin__tour-name">${escapeHtml(t.name)}</span></td>
          <td>${formatDuration(t.duration_hours)}</td>
          <td>${t.capacity ?? "—"}</td>
          <td><span class="admin__status admin__status--${t.is_active ? "active" : "archived"}">${
            t.is_active ? "Activa" : "Archivada"
          }</span></td>
          <td class="admin__col-actions">
            <button type="button" class="admin__link-btn" data-edit-tour="${t.id}">Editar</button>
            <a class="admin__link-btn" href="/admin/schedules?tour=${t.id}">Horarios</a>
            <a class="admin__link-btn" href="/admin/dates?tour=${t.id}">Fechas</a>
            <a class="admin__link-btn" href="/admin/images?tour=${t.id}">Imagenes</a>
            <a class="admin__link-btn" href="/admin/stops?tour=${t.id}">Puntos</a>
            <button type="button" class="admin__link-btn admin__link-btn--danger" data-toggle-tour="${t.id}" data-active="${t.is_active}">${
              t.is_active ? "Archivar" : "Reactivar"
            }</button>
          </td>`;
      }

      function escapeHtml(value: string) {
        const div = document.createElement("div");
        div.textContent = value;
        return div.innerHTML;
      }

      function upsertRow(tour: Tour) {
        knownTours.set(tour.id, tour);
        const emptyRow = tbody.querySelector(".admin__empty-row");
        emptyRow?.remove();

        let row = tbody.querySelector(`tr[data-tour-row="${tour.id}"]`) as HTMLTableRowElement | null;
        if (!row) {
          row = document.createElement("tr");
          row.setAttribute("data-tour-row", tour.id);
          tbody.prepend(row);
        }
        row.innerHTML = rowHtml(tour);
      }

      // Seed knownTours from the server-rendered rows so "Editar" works
      // immediately, without an extra fetch on page load.
      document.querySelectorAll<HTMLTableRowElement>("tr[data-tour-row]").forEach((row) => {
        const id = row.getAttribute("data-tour-row")!;
        knownTours.set(id, {
          id,
          name: row.querySelector(".admin__tour-name")?.textContent ?? "",
          description: "",
          meeting_point: null,
          meeting_point_lat: null,
          meeting_point_lng: null,
          duration_hours: null,
          capacity: null,
          is_active: row.querySelector("[data-toggle-tour]")?.getAttribute("data-active") === "true"
        });
      });

      async function fetchTour(id: string): Promise<Tour | null> {
        try {
          const res = await fetch(`/api/admin/tours/${id}`);
          if (!res.ok) return null;
          return await res.json();
        } catch {
          return null;
        }
      }

      async function refreshTourRow(id: string) {
        const fresh = await fetchTour(id);
        if (fresh) upsertRow(fresh);
      }

      function openPanel(tour?: Tour) {
        form.reset();
        panelError.classList.add("is-hidden");
        imageHint.textContent = "";
        coverPreview.classList.add("is-hidden");
        searchInput.value = "";

        ensureMap();

        if (tour) {
          panelTitle.textContent = "Editar excursión";
          idField.value = tour.id;
          nameField.value = tour.name;
          descField.value = tour.description;

          if (tour.duration_hours) {
            const totalMinutes = Math.round(tour.duration_hours * 60);
            durationHoursField.value = String(Math.floor(totalMinutes / 60));
            durationMinutesField.value = String(totalMinutes % 60);
          } else {
            durationHoursField.value = "";
            durationMinutesField.value = "";
          }

          capacityField.value = tour.capacity ? String(tour.capacity) : "";
          activeField.checked = tour.is_active;

          addressField.value = tour.meeting_point ?? "";
          if (tour.meeting_point_lat != null && tour.meeting_point_lng != null) {
            setMarker(Number(tour.meeting_point_lat), Number(tour.meeting_point_lng));
          } else {
            clearMarker();
          }

          const currentCover = tour.gallery?.[0];
          if (currentCover) {
            coverPreviewImg.src = currentCover.url;
            coverPreview.classList.remove("is-hidden");
            imageHint.textContent = "Sube un archivo solo si quieres reemplazar la imagen actual.";
          } else {
            imageHint.textContent = "";
          }
        } else {
          panelTitle.textContent = "Nueva excursión";
          idField.value = "";
          durationHoursField.value = "";
          durationMinutesField.value = "";
          activeField.checked = true;
          addressField.value = "";
          clearMarker();
        }

        overlay.classList.remove("is-hidden");
        nameField.focus();
        // Leaflet needs the container to be visible/sized before it can
        // compute its dimensions correctly.
        setTimeout(() => map?.invalidateSize(), 60);
      }

      function closePanel() {
        overlay.classList.add("is-hidden");
      }

      document.getElementById("new-tour-btn")?.addEventListener("click", () => openPanel());
      document.getElementById("panel-close")?.addEventListener("click", closePanel);
      document.getElementById("panel-cancel")?.addEventListener("click", closePanel);
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closePanel();
      });

      tbody.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;

        const editId = target.getAttribute("data-edit-tour");
        if (editId) {
          // The seeded summary (from the server-rendered rows) is missing
          // description/meeting point/gallery — fetch the full record
          // before opening the form.
          const fresh = await fetchTour(editId);
          const tour = fresh ?? knownTours.get(editId);
          if (tour) openPanel(tour);
          return;
        }

        const toggleId = target.getAttribute("data-toggle-tour");
        if (toggleId) {
          const isActive = target.getAttribute("data-active") === "true";

          const confirmed = await confirmDialog({
            title: isActive ? "Archivar excursión" : "Reactivar excursión",
            message: isActive
              ? "¿Archivar esta excursión? Dejará de verse en la web."
              : "¿Reactivar esta excursión? Volverá a verse en la web.",
            confirmLabel: isActive ? "Archivar" : "Reactivar",
            danger: isActive
          });
          if (!confirmed) return;

          target.setAttribute("disabled", "true");
          try {
            if (isActive) {
              const res = await fetch(`/api/admin/tours/${toggleId}`, { method: "DELETE" });
              if (!res.ok) throw new Error((await res.json())?.message);
            } else {
              const res = await fetch(`/api/admin/tours/${toggleId}`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ isActive: true })
              });
              if (!res.ok) throw new Error((await res.json())?.message);
            }
            showBanner(isActive ? "Excursión archivada." : "Excursión reactivada.");
            await refreshTourRow(toggleId);
          } catch (err: any) {
            showBanner(err?.message || "No se ha podido completar la operación.", true);
          } finally {
            target.removeAttribute("disabled");
          }
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        panelError.classList.add("is-hidden");

        if (
          !nameField.value.trim() ||
          !descField.value.trim() ||
          !addressField.value.trim() ||
          !latField.value ||
          !lngField.value
        ) {
          panelError.textContent =
            "Completa el nombre, la descripción y fija el punto de encuentro en el mapa.";
          panelError.classList.remove("is-hidden");
          return;
        }

        panelSubmit.disabled = true;
        panelSubmit.textContent = "Guardando…";

        try {
          const isEditing = Boolean(idField.value);

          const durationHours = (() => {
            const h = durationHoursField.value ? Number(durationHoursField.value) : 0;
            const m = durationMinutesField.value ? Number(durationMinutesField.value) : 0;
            if (!h && !m) return undefined;
            return Math.round((h + m / 60) * 100) / 100;
          })();

          const payload: Record<string, unknown> = {
            name: nameField.value.trim(),
            description: descField.value.trim(),
            meetingPoint: {
              address: addressField.value.trim(),
              lat: Number(latField.value),
              lng: Number(lngField.value)
            },
            durationHours,
            capacity: capacityField.value ? Number(capacityField.value) : undefined,
            isActive: activeField.checked
          };

          // Trim undefined keys — the backend schema rejects unexpected
          // properties, but `undefined` values still show up as own keys
          // after JSON.stringify unless removed first.
          Object.keys(payload).forEach((key) => payload[key] === undefined && delete payload[key]);

          const res = await fetch(isEditing ? `/api/admin/tours/${idField.value}` : "/api/admin/tours", {
            method: isEditing ? "PATCH" : "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          let tour = await res.json();
          if (!res.ok) throw new Error(tour?.message || "No se ha podido guardar la excursión.");

          // The tour now definitely has an id — only now can a cover photo
          // be attached to its gallery (the endpoint the site actually
          // reads covers from), whether this was a create or an edit.
          const file = imageField.files?.[0];
          if (file) {
            const uploadForm = new FormData();
            uploadForm.set("file", file);
            const uploadRes = await fetch("/api/admin/images", { method: "POST", body: uploadForm });
            const uploaded = await uploadRes.json();
            if (!uploadRes.ok) throw new Error(uploaded?.message || "No se ha podido subir la imagen.");

            const coverRes = await fetch(`/api/admin/tours/${tour.id}/cover-image`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ imageId: uploaded.id })
            });
            const coverData = await coverRes.json();
            if (!coverRes.ok) throw new Error(coverData?.message || "No se ha podido guardar la imagen destacada.");
          }

          upsertRow(tour);
          showBanner(isEditing ? "Excursión actualizada." : "Excursión creada.");
          closePanel();
        } catch (err: any) {
          panelError.textContent = err?.message || "No se ha podido guardar la excursión.";
          panelError.classList.remove("is-hidden");
        } finally {
          panelSubmit.disabled = false;
          panelSubmit.textContent = "Guardar excursión";
        }
      });
    </script>
