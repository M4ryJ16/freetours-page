---
// @ts-nocheck
import { listAllTours, listTourSchedules } from "@/lib/adminApi.js";
import AdminLayout from "@/components/AdminLayout.astro";
import AdminPageHead from "@/components/AdminPageHead.astro";
import AdminNotice from "@/components/AdminNotice.astro";
import AdminBanner from "@/components/AdminBanner.astro";
import AdminTourPicker from "@/components/AdminTourPicker.astro";
import AdminTourCard from "@/components/AdminTourCard.astro";
import AdminList from "@/components/AdminList.astro";
import AdminListItem from "@/components/AdminListItem.astro";
import AdminInlineForm from "@/components/AdminInlineForm.astro";

export const prerender = false;

interface ApiTour {
  id: string;
  name: string;
  is_active: boolean;
}

interface ApiSchedule {
  id: string;
  time: string;
  tour_id: string;
  created_at: string;
}

let tours: ApiTour[] = [];
let loadError: string | null = null;

try {
  tours = await listAllTours();
} catch (err) {
  console.error("No se han podido cargar las excursiones para el panel de horarios", err);
  loadError = "No se han podido cargar las excursiones. Recarga la página.";
}

const selectedTourId = Astro.url.searchParams.get("tour") || tours[0]?.id || "";
const selectedTour = tours.find((t) => t.id === selectedTourId) ?? null;

let schedules: ApiSchedule[] = [];
let scheduleError: string | null = null;

if (selectedTourId && !loadError) {
  try {
    schedules = await listTourSchedules(selectedTourId);
    schedules.sort((a, b) => a.time.localeCompare(b.time));
  } catch (err) {
    console.error("No se han podido cargar los horarios", err);
    scheduleError = "No se han podido cargar los horarios de esta ruta.";
  }
}

// tour_schedules.time comes back as "HH:MM:SS" — trim the seconds for display.
const formatTime = (value: string) => value?.slice(0, 5) ?? value;
---

<AdminLayout title="Horarios de excursiones" tag="Panel de horarios" tourId={selectedTourId} confirm>
  <AdminPageHead eyebrow="Catálogo" title="Horarios" />

  {loadError && <AdminNotice error>{loadError}</AdminNotice>}

  <AdminBanner />

  {!loadError && <AdminTourPicker tours={tours} selectedTourId={selectedTourId} />}

  {!loadError && selectedTour && (
    <AdminTourCard tour={selectedTour} cardId="schedules-card" title="Horarios de" error={scheduleError}>
      <AdminList
        id="schedule-list"
        empty={schedules.length === 0 ? "Todavía no hay horarios para esta ruta." : undefined}
        emptyId="schedule-empty"
      >
        {schedules.map((s) => (
          <AdminListItem
            label={formatTime(s.time)}
            data-schedule-id={s.id}
            deleteAttrs={{ "data-delete-schedule": s.id }}
          />
        ))}
      </AdminList>

      <div class="quick-add">
        <p class="quick-add__label">Horarios habituales</p>
        <div class="quick-add__buttons">
          <button type="button" class="btn quick-add__btn" data-quick-time="10:00">+ 10:00</button>
          <button type="button" class="btn quick-add__btn" data-quick-time="14:00">+ 14:00</button>
          <button type="button" class="btn quick-add__btn" data-quick-time="17:00">+ 17:00</button>
          <button type="button" class="btn orange-btn quick-add__btn" id="quick-add-all">Añadir los 3</button>
        </div>
      </div>

      <AdminInlineForm
        formId="add-schedule-form"
        label="Añadir hora de salida"
        inputId="new-time"
        inputType="time"
        buttonId="add-schedule-btn"
        errorId="add-schedule-error"
      />
    </AdminTourCard>
  )}
</AdminLayout>

<style is:global>
  .quick-add { margin-bottom: 20px; }

  .quick-add__label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #4a5b4c;
    margin: 0 0 8px;
  }

  .quick-add__buttons { display: flex; gap: 10px; flex-wrap: wrap; }

  .quick-add__btn {
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.22);
    color: var(--ink);
    padding: 8px 16px;
    font-size: 0.88rem;
    border-radius: var(--radius);
    cursor: pointer;
  }

  .quick-add__btn:hover { border-color: var(--gold); }

  .quick-add__btn:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<script>
      import { initConfirmDialog, confirmDialog } from "@/lib/confirmDialog.js";

      initConfirmDialog();


      const banner = document.getElementById("admin-banner") as HTMLParagraphElement | null;
      const scheduleCard = document.getElementById("schedules-card") as HTMLDivElement | null;
      const scheduleList = document.getElementById("schedule-list") as HTMLUListElement | null;
      const addForm = document.getElementById("add-schedule-form") as HTMLFormElement | null;
      const newTimeInput = document.getElementById("new-time") as HTMLInputElement | null;
      const addBtn = document.getElementById("add-schedule-btn") as HTMLButtonElement | null;
      const addError = document.getElementById("add-schedule-error") as HTMLParagraphElement | null;

      function showBanner(message: string, isError = false) {
        if (!banner) return;
        banner.textContent = message;
        banner.classList.remove("is-hidden");
        banner.classList.toggle("admin__banner--error", isError);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }


      function formatTime(value: string) {
        return value?.slice(0, 5) ?? value;
      }

      function emptyStateRow(): HTMLLIElement {
        const li = document.createElement("li");
        li.className = "schedule-list__empty";
        li.id = "schedule-empty";
        li.textContent = "Todavía no hay horarios para esta ruta.";
        return li;
      }

      function scheduleRow(schedule: { id: string; time: string }): HTMLLIElement {
        const li = document.createElement("li");
        li.className = "schedule-list__item";
        li.setAttribute("data-schedule-id", schedule.id);
        li.innerHTML = `
          <span class="schedule-list__time">${formatTime(schedule.time)}</span>
          <button type="button" class="admin__link-btn admin__link-btn--danger" data-delete-schedule="${schedule.id}">Eliminar</button>
        `;
        return li;
      }

      async function addSchedule(time: string): Promise<{ ok: boolean; message?: string }> {
        if (!scheduleCard) return { ok: false };
        const tourId = scheduleCard.getAttribute("data-tour-id");
        if (!tourId || !time) return { ok: false };

        try {
          const res = await fetch(`/api/admin/tours/${tourId}/schedules`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ time })
          });
          const data = await res.json();
          if (!res.ok) return { ok: false, message: data?.message || "No se ha podido añadir el horario." };

          scheduleList?.querySelector("#schedule-empty")?.remove();
          const row = scheduleRow(data);
          const items = [...(scheduleList?.querySelectorAll<HTMLLIElement>(".schedule-list__item") ?? [])];
          const next = items.find((item) => (item.querySelector(".schedule-list__time")?.textContent ?? "") > formatTime(data.time));
          if (next) {
            scheduleList?.insertBefore(row, next);
          } else {
            scheduleList?.appendChild(row);
          }
          return { ok: true };
        } catch (err: any) {
          return { ok: false, message: err?.message };
        }
      }

      addForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!newTimeInput || !addBtn) return;

        addError?.classList.add("is-hidden");
        const time = newTimeInput.value;
        if (!time) return;

        addBtn.disabled = true;
        addBtn.textContent = "Añadiendo…";

        const result = await addSchedule(time);

        addBtn.disabled = false;
        addBtn.textContent = "Añadir";

        if (result.ok) {
          newTimeInput.value = "";
          showBanner("Horario añadido.");
        } else if (addError) {
          addError.textContent = result.message || "No se ha podido añadir el horario.";
          addError.classList.remove("is-hidden");
        }
      });

      function existingTimes(): string[] {
        return [...(scheduleList?.querySelectorAll<HTMLSpanElement>(".schedule-list__time") ?? [])].map(
          (el) => el.textContent ?? ""
        );
      }

      document.querySelectorAll<HTMLButtonElement>("[data-quick-time]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const time = btn.getAttribute("data-quick-time");
          if (!time) return;

          if (existingTimes().includes(time)) {
            showBanner(`Ya existe un horario a las ${time}.`, true);
            return;
          }

          btn.disabled = true;
          const result = await addSchedule(time);
          btn.disabled = false;

          showBanner(result.ok ? `Horario ${time} añadido.` : (result.message || "No se ha podido añadir el horario."), !result.ok);
        });
      });

      document.getElementById("quick-add-all")?.addEventListener("click", async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const presets = ["10:00", "14:00", "17:00"];
        const already = existingTimes();
        const toAdd = presets.filter((t) => !already.includes(t));

        if (toAdd.length === 0) {
          showBanner("Los 3 horarios habituales ya existen.");
          return;
        }

        btn.disabled = true;
        let added = 0;
        let failed = 0;
        for (const time of toAdd) {
          const result = await addSchedule(time);
          if (result.ok) added += 1;
          else failed += 1;
        }
        btn.disabled = false;

        showBanner(
          failed > 0
            ? `Se añadieron ${added} horario(s). ${failed} no se pudieron añadir.`
            : `Se añadieron ${added} horario(s).`,
          failed > 0
        );
      });
    

      scheduleList?.addEventListener("click", async (e) => {
        const target = (e.target as HTMLElement).closest<HTMLElement>("[data-delete-schedule]");
        const scheduleId = target?.getAttribute("data-delete-schedule");
        if (!target || !scheduleId || !scheduleCard || !scheduleList) return;

        const confirmed = await confirmDialog({
          title: "Eliminar horario",
          message: "¿Eliminar este horario? Esta acción no se puede deshacer.",
          confirmLabel: "Eliminar"
        });
        if (!confirmed) return;

        const tourId = scheduleCard.getAttribute("data-tour-id");
        if (!tourId) return;

        target.setAttribute("disabled", "true");
        try {
          const res = await fetch(`/api/admin/tours/${tourId}/schedules/${scheduleId}`, { method: "DELETE" });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data?.message || "No se ha podido eliminar el horario.");

          scheduleList.querySelector(`li[data-schedule-id="${scheduleId}"]`)?.remove();
          if (!scheduleList.querySelector(".schedule-list__item")) {
            scheduleList.appendChild(emptyStateRow());
          }
          showBanner("Horario eliminado.");
        } catch (err: any) {
          showBanner(err?.message || "No se ha podido eliminar el horario. Puede que ya tenga reservas asociadas.", true);
        } finally {
          target.removeAttribute("disabled");
        }
      });
</script>
