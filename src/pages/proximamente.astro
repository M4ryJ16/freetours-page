---
import Nav from "@/components/Nav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import "@/styles/global.css";
import AutoTranslator from "@/components/AutoTranslator.astro";

interface Props {
  feature?: string;
}

const { feature = "Esta función" } = Astro.props as Props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Próximamente — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <section class="soon">
        <div class="wrap soon__inner">
          <p class="eyebrow soon__eyebrow">Muy pronto</p>
          <h1 class="soon__title">{feature} está en camino</h1>
          <p class="soon__text">
            Estamos preparando esta parte de la web para que tu experiencia
            reservando y descubriendo Dublín sea aún mejor. Vuelve pronto
            para verlo en marcha.
          </p>

          <div class="soon__actions">
            <a href="/" class="btn orange-btn rounded-btn">Volver al inicio</a>
            <a href="/reservar" class="btn btn-ghost">Reservar un tour</a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter showLegalLinks={false} />
    <AutoTranslator />
  </body>
</html>

<style is:global>
  .soon {
    min-height: 72vh;
    display: flex;
    align-items: center;
    background: var(--forest-deep);
    color: var(--parchment-alt);
  }

  .soon__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 90px;
  }

  .soon__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.15;
    margin: 14px 0 18px;
  }

  .soon__text {
    max-width: 48ch;
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 36px;
  }

  .soon__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .soon__inner { padding-block: 60px; }
  }

</style>
