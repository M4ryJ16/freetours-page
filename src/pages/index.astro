---
// @ts-nocheck
import Nav from "@/components/Nav.astro";
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import Hero from "@/components/Hero.astro";
import Tours from "@/components/Tours.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import "@/styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meriyo Tours (Dublin) — Freetours en Dublín</title>
    <link rel="icon" href="/web-icon-orange.svg">
    <meta
      name="description"
      content="Free tours en Dublín guiados por locales. Historia, mitos y rincones escondidos, a ritmo tranquilo."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <Hero />
      <Tours />
    </main>

    <SiteFooter />
    <WhatsAppButton />
  </body>
</html>
