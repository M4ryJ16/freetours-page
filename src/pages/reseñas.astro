---
import Nav from "@/components/Nav.astro";
import ReviewCard from "@/components/ReviewCard.astro";
import ReviewFormCard from "@/components/ReviewFormCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import {
  getTours,
  getTourGallery,
  getAllTourReviews,
  getTourReviewSummary,
  getCurrentCustomer,
  ApiError,
} from "@/lib/api.js";
import { getSessionToken, clearSessionCookie } from "@/lib/session.js";
import "@/styles/global.css";
import AutoTranslator from "@/components/AutoTranslator.astro";

// This page reads the session cookie and hits several endpoints per
// request (same reasoning as Booking.astro / the tour detail page), so it
// can't be statically prerendered.
export const prerender = false;

interface ApiTour {
  id: string;
  name: string;
  description: string;
  duration_hours: number | null;
  capacity: number | null;
  is_active: boolean;
}

interface TourWithCover extends ApiTour {
  cover: string | null;
}

interface ApiReview {
  id: string;
  stars: number;
  content: string | null;
  tour_id: string;
  customer_id: string;
  created_at: string;
  tour_name: string;
  customer_name: string;
}

interface ReviewSummary {
  tourId: string;
  reviewCount: number;
  averageStars: number;
  breakdown: Record<string, number>;
}

interface CurrentCustomer {
  id: string;
  full_name: string;
  email: string;
}

// --- Tours (active only, same as Tours.astro) ---
let tours: TourWithCover[] = [];
let loadError = false;

try {
  const activeTours: ApiTour[] = await getTours({ active: true });
  tours = await Promise.all(
    activeTours.map(async (t) => {
      try {
        const gallery = await getTourGallery(t.id);
        return { ...t, cover: gallery[0]?.url ?? null };
      } catch {
        return { ...t, cover: null };
      }
    })
  );
} catch (err) {
  console.error("Failed to load tours from the API", err);
  loadError = true;
}

// --- Per-tour summaries (average stars + count), used for the "by route" cards ---
const summaries = new Map<string, ReviewSummary>();
let summariesError = false;

if (!loadError) {
  try {
    const results = await Promise.all(
      tours.map((t) =>
        getTourReviewSummary(t.id).catch(
          (): ReviewSummary => ({
            tourId: t.id,
            reviewCount: 0,
            averageStars: 0,
            breakdown: {},
          })
        )
      )
    );
    results.forEach((s) => summaries.set(s.tourId, s));
  } catch (err) {
    console.error("Failed to load review summaries", err);
    summariesError = true;
  }
}

// --- Every review across every active tour, newest first ---
// There's no single "all reviews" endpoint, so we fetch per tour (same
// call the tour detail page already makes) and merge them here.
let allReviews: ApiReview[] = [];
let reviewsError = false;

if (!loadError) {
  try {
    const perTour = await Promise.all(
      tours.map((t) => getAllTourReviews(t.id).catch(() => [] as ApiReview[]))
    );
    allReviews = perTour
      .flat()
      .sort(
        (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
      );
  } catch (err) {
    console.error("Failed to load reviews from the API", err);
    reviewsError = true;
  }
}

const totalReviews = allReviews.length;
const overallAverage =
  totalReviews > 0
    ? allReviews.reduce((sum, r) => sum + r.stars, 0) / totalReviews
    : 0;

// --- Logged-in customer (same pattern as Booking.astro / tour detail page) ---
let currentCustomer: CurrentCustomer | null = null;
const sessionToken = getSessionToken(Astro.cookies);
if (sessionToken) {
  try {
    currentCustomer = await getCurrentCustomer(sessionToken);
  } catch {
    clearSessionCookie(Astro.cookies);
  }
}

// --- Eligibility: just needs an active session. Any logged-in customer
// can review any active tour — the picker below lists every active tour,
// and the API is the source of truth for "already reviewed this tour"
// when the form is submitted, exactly like it does on the tour detail page.
const canShowForm = !!currentCustomer && tours.length > 0;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reseñas — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta
      name="description"
      content="Todas las opiniones de nuestros viajeros sobre las rutas de Meriyo Tours en Dublín."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <section class="reviews-hub-hero">
        <div class="wrap">
          <p class="eyebrow">Opiniones</p>
          <h1 class="reviews-hub-hero__title">Lo que dicen nuestros viajeros</h1>
          <p class="reviews-hub-hero__lede">
            Reseñas reales de personas que hicieron alguna de nuestras rutas por Dublín.
          </p>
        </div>
      </section>

    {!reviewsError && canShowForm && (
        <section class="reviews-hub-form-section">
          <div class="wrap">
            <ReviewFormCard
              tours={tours.map((t) => ({ id: t.id, name: t.name }))}
              hint="Elige la ruta que quieres reseñar."
              liveUpdate={false}
              doneMessage="¡Gracias! Tu reseña se ha publicado. Actualiza la página para verla en el listado."
            />
          </div>
        </section>
      )}

      <section class="reviews-hub-bytour">
        <div class="wrap">
          <p class="eyebrow">Por ruta</p>
          <h2 class="reviews-hub-section-title">Reseñas por ruta</h2>

          {loadError && (
            <p class="reviews-hub-notice">
              No hemos podido cargar las rutas en este momento. Inténtalo de nuevo más tarde.
            </p>
          )}

          {!loadError && tours.length === 0 && (
            <p class="reviews-hub-notice">Todavía no hay rutas publicadas.</p>
          )}

          {!loadError && tours.length > 0 && (
            <div class="tour-summary-grid">
              {tours.map((t) => {
                const s = summaries.get(t.id);
                return (
                  <a href={`/tours/${t.id}#reviews`} class="tour-summary-card">
                    <div
                      class={`tour-summary-card__media${t.cover ? "" : " tour-summary-card__media--empty"}`}
                      style={t.cover ? `background-image:url(${t.cover})` : undefined}
                    >
                      <div class="tour-summary-card__scrim"></div>
                      <h3 class="tour-summary-card__name">{t.name}</h3>
                    </div>
                    <div class="tour-summary-card__footer">
                      {s && s.reviewCount > 0 ? (
                        <span class="tour-summary-card__rating">
                          ★ {s.averageStars.toFixed(1)}
                          <span class="tour-summary-card__count">
                            ({s.reviewCount} {s.reviewCount === 1 ? "reseña" : "reseñas"})
                          </span>
                        </span>
                      ) : (
                        <span class="tour-summary-card__rating tour-summary-card__rating--empty">
                          Sin reseñas todavía
                        </span>
                      )}
                      <span class="tour-summary-card__link">Ver ruta y reseñas →</span>
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </div>
      </section>

      <section class="reviews-hub-all">
        <div class="wrap">
          <div class="reviews-hub-all__head">
            <div>
              <p class="eyebrow">Todas</p>
              <h2 class="reviews-hub-section-title" id="all-reviews">Todas las opiniones</h2>
            </div>

            {!reviewsError && !loadError && tours.length > 0 && totalReviews > 0 && (
              <div class="reviews-hub-filter">
                <label for="reviews-filter">Filtrar por ruta</label>
                <select id="reviews-filter">
                  <option value="all">Todas las rutas</option>
                  {tours.map((t) => (
                    <option value={t.id}>{t.name}</option>
                  ))}
                </select>
              </div>
            )}
          </div>

          {reviewsError && (
            <p class="reviews-hub-notice">
              No hemos podido cargar las reseñas en este momento. Inténtalo de nuevo más tarde.
            </p>
          )}

          {!reviewsError && totalReviews === 0 && (
            <p class="reviews-hub-notice" id="reviews-empty-notice">
              Todavía no hay reseñas publicadas.
            </p>
          )}

          {!reviewsError && totalReviews > 0 && (
            <>
              <div class="tours__grid" id="reviews-grid">
                {allReviews.map((r, i) => (
                  <div
                    class="reviews-hub-item"
                    data-tour-id={r.tour_id}
                    data-index={i}
                    style={i >= 9 ? "display:none" : undefined}
                  >
                    <ReviewCard
                      content={r.content}
                      stars={r.stars}
                      customerName={r.customer_name}
                      tourName={r.tour_name}
                    />
                  </div>
                ))}
              </div>

              {totalReviews > 9 && (
                <div class="reviews-hub-loadmore">
                  <button type="button" class="btn btn-ghost" id="reviews-load-more">
                    Cargar más reseñas
                  </button>
                </div>
              )}

              <p class="reviews-hub-notice is-hidden" id="reviews-filter-empty">
                No hay reseñas todavía para esta ruta.
              </p>
            </>
          )}
        </div>
      </section>
    </main>

    <SiteFooter />
    <AutoTranslator />
  </body>
</html>

<style is:global>
  .reviews-hub-hero {
    background: var(--parchment);
    padding-block: 70px 40px;
  }
  .reviews-hub-hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    color: var(--ink);
    margin: 10px 0 14px;
  }
  .reviews-hub-hero__lede {
    font-size: 1rem;
    line-height: 1.7;
    color: #3c4a3d;
    margin: 0 0 30px;
    max-width: 60ch;
  }

  .reviews-hub-stats {
    display: flex;
    align-items: center;
    gap: 28px;
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.1);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 22px 28px;
    max-width: 560px;
  }
  .reviews-hub-stats__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .reviews-hub-stats__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.7rem;
    color: var(--ink);
  }
  .reviews-hub-stats__label {
    font-size: 0.78rem;
    color: #5a6b5c;
  }
  .reviews-hub-stats__divider {
    width: 1px;
    align-self: stretch;
    background: rgba(24, 34, 25, 0.12);
  }

  .reviews-hub-form-section {
    background: var(--parchment);
    padding-block: 0 50px;
  }

  .reviews-hub-bytour {
    background: var(--parchment);
    padding-block: 10px 70px;
  }
  .reviews-hub-all {
    background: var(--parchment);
    padding-block: 10px 100px;
  }

  .reviews-hub-section-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    color: var(--ink);
    margin: 10px 0 30px;
  }

  .reviews-hub-notice {
    font-size: 0.95rem;
    color: #5a6b5c;
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.12);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin: 0 0 20px;
  }
  .reviews-hub-notice.is-hidden { display: none; }

  /* ---------- Per-tour summary cards ---------- */
  .tour-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .tour-summary-card {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(24, 34, 25, 0.1);
    border-top: 3px solid var(--gold);
    background: var(--cream);
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .tour-summary-card:hover,
  .tour-summary-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(24, 34, 25, 0.12);
  }
  .tour-summary-card__media {
    position: relative;
    height: 170px;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
    padding: 18px;
  }
  .tour-summary-card__media--empty {
    background: linear-gradient(160deg, var(--forest-deep), #2c3d2d);
  }
  .tour-summary-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 14, 10, 0.85) 0%, rgba(10, 14, 10, 0.1) 70%);
  }
  .tour-summary-card__name {
    position: relative;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: #fff;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }
  .tour-summary-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    gap: 10px;
    flex-wrap: wrap;
  }
  .tour-summary-card__rating {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--russet);
  }
  .tour-summary-card__rating--empty {
    font-style: normal;
    color: #8a8272;
    font-family: var(--font-body);
    font-size: 0.85rem;
  }
  .tour-summary-card__count {
    font-style: normal;
    color: #8a8272;
    font-size: 0.8rem;
  }
  .tour-summary-card__link {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--forest-deep);
    font-weight: 600;
  }

  /* ---------- All-reviews grid + filter ---------- */
  .reviews-hub-all__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 6px;
  }
  .reviews-hub-filter {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .reviews-hub-filter label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #4a5b4c;
  }
  .reviews-hub-filter select {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.22);
    border-radius: var(--radius);
    padding: 8px 12px;
  }

  .tours__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .reviews-hub-loadmore {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  /* Tour name badge, mirrors ReviewCard's own tour_name styling */
  .review-card__tour {
    font-size: 0.78rem;
    color: #8a8272;
    margin: 2px 0 0;
  }

  @media (max-width: 940px) {
    .tour-summary-grid { grid-template-columns: 1fr 1fr; }
    .tours__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .tour-summary-grid { grid-template-columns: 1fr; }
    .tours__grid { grid-template-columns: 1fr; }
    .reviews-hub-stats { flex-wrap: wrap; gap: 18px; }
  }

</style>

<script>
  // ---------- Filter the "all reviews" grid by tour ----------
  const filterSelect = document.getElementById("reviews-filter") as HTMLSelectElement | null;
  const emptyNotice = document.getElementById("reviews-filter-empty") as HTMLParagraphElement | null;
  const loadMoreBtn = document.getElementById("reviews-load-more") as HTMLButtonElement | null;

  const PAGE_SIZE = 9;
  let visibleCount = PAGE_SIZE;
  let activeTourId = "all";

  function applyFilterAndPaging() {
    const items = document.querySelectorAll<HTMLElement>(".reviews-hub-item");
    let shownSoFar = 0;
    let matchCount = 0;

    items.forEach((item) => {
      const matches = activeTourId === "all" || item.dataset.tourId === activeTourId;
      if (!matches) {
        item.style.display = "none";
        return;
      }
      matchCount++;
      if (shownSoFar < visibleCount) {
        item.style.display = "";
        shownSoFar++;
      } else {
        item.style.display = "none";
      }
    });

    if (emptyNotice) {
      emptyNotice.classList.toggle("is-hidden", matchCount !== 0);
    }
    if (loadMoreBtn) {
      loadMoreBtn.style.display = matchCount > shownSoFar ? "" : "none";
    }
  }

  filterSelect?.addEventListener("change", () => {
    activeTourId = filterSelect.value;
    visibleCount = PAGE_SIZE;
    applyFilterAndPaging();
  });

  loadMoreBtn?.addEventListener("click", () => {
    visibleCount += PAGE_SIZE;
    applyFilterAndPaging();
  });

  applyFilterAndPaging();
</script>

