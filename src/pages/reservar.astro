---
import Nav from "@/components/Nav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import Booking from "@/components/Booking.astro";
import "@/styles/global.css";
import AutoTranslator from "@/components/AutoTranslator.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reserva tu tour — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta
      name="description"
      content="Reserva tu free tour en Dublín en pocos minutos: elige ruta, fecha y número de personas."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <Booking />
    </main>

    <SiteFooter />
    <WhatsAppButton />
    <AutoTranslator />
  </body>
</html>

