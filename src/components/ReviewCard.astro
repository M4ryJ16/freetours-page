---
import StarRating from "./StarRating.astro";

interface Props {
  content: string | null;
  stars: number;
  customerName: string;
  // Shown when a review needs to say which tour it's for (homepage, where
  // reviews span the whole catalog). Omit on the tour detail page, where
  // it's redundant.
  tourName?: string;
}

const { content, stars, customerName, tourName } = Astro.props;
---

<div class="review-card">
  <div class="review-card__stars">
    <StarRating stars={stars} />
  </div>

  {content && <p class="review-card__quote">&ldquo;{content}&rdquo;</p>}

  <p class="review-card__reviewer">{customerName}</p>
  {tourName && <p class="review-card__reviewer"><span>— {tourName}</span></p>}
</div>

<style is:global>
  .review-card {
    border: 1px dashed black;
    padding: 20px;
  }

  .review-card__stars {
    margin-bottom: 8px;
  }

  .review-card__quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink);
    margin: 0 0 10px;
  }

  .review-card__reviewer {
    font-size: 0.8rem;
    font-weight: 600;
    margin: 0;
    color: var(--russet);
  }
  .review-card__reviewer span {
    font-weight: 400;
    color: #6b6355;
  }
</style>
