---
// src/components/AutoTranslator.astro
---

<script>
  // ==========================================
  // FLAG DE CACHÉ: Cambia a "v2", "v3", etc. al modificar textos.
  // ==========================================
  const VERSION_TEXTOS: string = "v2";

  async function translateAllAtOnce(): Promise<void> {
    // 1. Detección automática del idioma
    let lang: string | null = localStorage.getItem('site_lang');
    
    // Si no hay idioma configurado, lo detectamos del navegador
    if (!lang) {
      const browserLang = navigator.language || (navigator.languages && navigator.languages[0]);
      // Extraemos solo el código base (ej. 'en-US' -> 'en', 'fr-FR' -> 'fr')
      lang = browserLang ? browserLang.split('-')[0] : 'es';
      
      // Guardamos la preferencia para futuras visitas
      localStorage.setItem('site_lang', lang);
    }

    // Si el idioma final es español (idioma original), detenemos el proceso
    if (lang === 'es') return; 

    // 2. Escanea la página
    const walker: TreeWalker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    const nodesToTranslate: Text[] = [];
    const textsToTranslate: string[] = [];
    let node: Node | null;

    while ((node = walker.nextNode())) {
      const textNode = node as Text;
      
      const text: string = textNode.nodeValue?.trim() || '';
      const parentTag: string = textNode.parentElement ? textNode.parentElement.tagName : '';
      
      if (text.length > 0 && parentTag !== 'SCRIPT' && parentTag !== 'STYLE' && parentTag !== 'NOSCRIPT') {
        nodesToTranslate.push(textNode);
        textsToTranslate.push(text);
      }
    }

    if (textsToTranslate.length === 0) return;

    // 3. Obtenemos la URL actual y la caché
    const currentPath: string = window.location.pathname.replace(/[^a-zA-Z0-9]/g, '_') || '_home';
    const cacheKey: string = `traduccion_${lang}_${currentPath}_${VERSION_TEXTOS}`;
    
    // Auto-limpieza de caché antigua
    Object.keys(localStorage).forEach((key: string) => {
      if (key.startsWith('traduccion_') && !key.endsWith(`_${VERSION_TEXTOS}`)) {
        localStorage.removeItem(key);
      }
    });

    let translatedFullText: string | null = localStorage.getItem(cacheKey);

    // 4. Petición a la API de Google si no hay caché
    if (!translatedFullText) {
      const separator: string = "\n~~\n"; 
      const fullText: string = textsToTranslate.join(separator);

      try {
        const response: Response = await fetch("https://translate.googleapis.com/translate_a/single?client=gtx&sl=es&tl=" + lang + "&dt=t", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: "q=" + encodeURIComponent(fullText)
        });

        const data = await response.json() as any[];
        translatedFullText = "";
        
        if (Array.isArray(data[0])) {
          data[0].forEach((chunk: any[]) => {
            if (chunk[0]) translatedFullText += (chunk[0] as string);
          });
        }

        // Guardamos el resultado en caché
        localStorage.setItem(cacheKey, translatedFullText);

      } catch (error: unknown) {
        console.error("Fallo al traducir la página:", error);
        return; 
      }
    }

    // 5. Cortamos y aplicamos la traducción al DOM
    if (!translatedFullText) return;

    const translatedParts: string[] = translatedFullText.split(/\s*~~\s*/);

    nodesToTranslate.forEach((textNode: Text, index: number) => {
      if (translatedParts[index] && translatedParts[index].trim() !== "") {
        textNode.nodeValue = translatedParts[index].replace(/&amp;/g, '&').trim();
      }
    });
  }

  window.addEventListener('load', translateAllAtOnce);
</script>