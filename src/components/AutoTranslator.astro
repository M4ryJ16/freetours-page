---
// src/components/AutoTranslator.astro

// Global configuration constants from environment variables
const TRANSLATION_VERSION: string = import.meta.env.TRANSLATION_VERSION ?? "v1";
const USE_CACHE: boolean = String(import.meta.env.USE_CACHE ?? "true").toLowerCase() !== "false" && import.meta.env.USE_CACHE !== "0";
---

<script define:vars={{ TRANSLATION_VERSION, USE_CACHE }}>
  // Helper function to preserve initial capitalization if the original text had it
  function matchCapitalization(original, translated) {
    if (!original || !translated) return translated;
    
    const firstCharOriginal = original.charAt(0);
    const firstCharTranslated = translated.charAt(0);

    if (firstCharOriginal === firstCharOriginal.toUpperCase() && firstCharOriginal !== firstCharOriginal.toLowerCase()) {
      return firstCharTranslated.toUpperCase() + translated.slice(1);
    }
    
    return translated;
  }

  // Helper function to preserve leading and trailing spaces from the original text node
  function preserveSpacing(originalNodeValue, translatedText) {
    const leadingMatch = originalNodeValue.match(/^(\s*)/);
    const trailingMatch = originalNodeValue.match(/(\s*)$/);
    
    const leadingSpaces = leadingMatch ? leadingMatch[1] : '';
    const trailingSpaces = trailingMatch ? trailingMatch[1] : '';
    
    return leadingSpaces + translatedText + trailingSpaces;
  }

  async function translateAllAtOnce() {
    // 1. Automatic language detection
    let lang = localStorage.getItem('site_lang');
    
    if (!lang) {
      const browserLang = navigator.language || (navigator.languages && navigator.languages[0]);
      lang = browserLang ? browserLang.split('-')[0] : 'es';
      localStorage.setItem('site_lang', lang);
    }

    // Stop process if target language is Spanish (original language)
    if (lang === 'es') return; 

    // 2. Scan the document body for text nodes
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    const nodesToTranslate = [];
    const textsToTranslate = [];
    let node;

    while ((node = walker.nextNode())) {
      const textNode = node;
      const rawValue = textNode.nodeValue || '';
      const trimmedText = rawValue.trim();
      const parentTag = textNode.parentElement ? textNode.parentElement.tagName : '';
      
      // We check if it has content and is not inside forbidden tags
      if (trimmedText.length > 0 && parentTag !== 'SCRIPT' && parentTag !== 'STYLE' && parentTag !== 'NOSCRIPT') {
        nodesToTranslate.push(textNode);
        // We push the trimmed text to Google Translate, but we keep track of the raw node value elsewhere if needed
        textsToTranslate.push(trimmedText);
      }
    }

    if (textsToTranslate.length === 0) return;

    // 3. Handle caching mechanism based on global configuration
    const currentPath = window.location.pathname.replace(/[^a-zA-Z0-9]/g, '_') || '_home';
    const cacheKey = `translation_${lang}_${currentPath}_${TRANSLATION_VERSION}`;
    
    // Auto-cleanup legacy cache keys if caching is enabled
    if (USE_CACHE) {
      Object.keys(localStorage).forEach((key) => {
        if (key.startsWith('translation_') && !key.endsWith(`_${TRANSLATION_VERSION}`)) {
          localStorage.removeItem(key);
        }
      });
    }

    let translatedFullText = USE_CACHE ? localStorage.getItem(cacheKey) : null;

    // 4. Request translation from Google API if not cached or cache is disabled
    if (!translatedFullText) {
      const separator = "\n~~\n"; 
      const fullText = textsToTranslate.join(separator);

      try {
        const response = await fetch("https://translate.googleapis.com/translate_a/single?client=gtx&sl=es&tl=" + lang + "&dt=t", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: "q=" + encodeURIComponent(fullText)
        });

        const data = await response.json();
        translatedFullText = "";
        
        if (Array.isArray(data[0])) {
          data[0].forEach((chunk) => {
            if (chunk[0]) translatedFullText += chunk[0];
          });
        }

        if (USE_CACHE) {
          localStorage.setItem(cacheKey, translatedFullText);
        }

      } catch (error) {
        console.error("Failed to translate the page:", error);
        return; 
      }
    }

    // 5. Split chunks, fix capitalization, restore spaces, and apply translations to the DOM
    if (!translatedFullText) return;

    const translatedParts = translatedFullText.split(/\s*~~\s*/);

    nodesToTranslate.forEach((textNode, index) => {
      const originalText = textsToTranslate[index];
      let translatedText = translatedParts[index];

      if (translatedText && translatedText.trim() !== "") {
        translatedText = translatedText.replace(/&amp;/g, '&').trim();
        
        // Enforce initial capitalization preservation
        translatedText = matchCapitalization(originalText, translatedText);
        
        // Restore original leading and trailing spaces
        textNode.nodeValue = preserveSpacing(textNode.nodeValue, translatedText);
      }
    });
  }

  window.addEventListener('load', translateAllAtOnce);
</script>